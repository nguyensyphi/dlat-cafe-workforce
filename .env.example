# Database (PostgreSQL 17 on port 5433 via docker-compose.yml)
POSTGRES_USER=cafe_admin
POSTGRES_PASSWORD=cafe_secret_2026
POSTGRES_DB=cafe_workforce
DATABASE_URL="postgresql://cafe_admin:cafe_secret_2026@127.0.0.1:5433/cafe_workforce?schema=public"

# Authentication
JWT_SECRET="change-this-to-a-secure-64-char-random-secret-in-production-2026"
SESSION_COOKIE_NAME="cafe_wf_session"
SESSION_TTL_HOURS=168

# Application
NEXT_PUBLIC_APP_NAME="D'lat Cafe Workforce"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Ho_Chi_Minh"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Multi-Channel Notifications (Leave empty to safely skip external delivery)
# ==============================================================================

# Telegram Bot API
TELEGRAM_BOT_TOKEN=""
TELEGRAM_API_BASE_URL="https://api.telegram.org"
TELEGRAM_DEFAULT_CHAT_ID=""

# Zalo OA / ZNS / Custom Webhook
ZALO_OA_ACCESS_TOKEN=""
ZALO_OA_API_URL="https://openapi.zalo.me/v3.0/oa/message/cs"
ZALO_ZNS_API_URL="https://business.openapi.zalo.me/message/template"
ZALO_ZNS_TEMPLATE_ID=""
ZALO_WEBHOOK_URL=""
ZALO_WEBHOOK_SECRET=""

# Email via Resend REST API (takes precedence over SMTP if RESEND_API_KEY is set)
RESEND_API_KEY=""
RESEND_API_URL="https://api.resend.com/emails"

# Email via SMTP (Nodemailer)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="D'lat Cafe Workforce <no-reply@dlatcafe.local>"

# Shift Reminders Cron & Alert Threshold Defaults
CRON_SECRET=""
ENABLE_IN_PROCESS_CRON="false"
SHIFT_START_REMINDER_MINUTES=15
SHIFT_END_REMINDER_MINUTES=15
NOTIFICATION_CASH_DISCREPANCY_THRESHOLD_VND=0
NOTIFICATION_TIMEOUT_MS=5000

# ==============================================================================
# Production 24/7 Deployment (Docker Compose Profiles: 'tunnel' | 'vps')
# ==============================================================================
APP_PORT=3000
BACKUP_RETENTION_DAYS=14
# Profile 'tunnel' (Cafe PC / Mini-PC): Token from Cloudflare Zero Trust -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=""
# Profile 'vps' (Cloud VPS with Public IP): Domain pointed to VPS IP for Caddy Let's Encrypt SSL
APP_DOMAIN="workforce.dlatcafe.vn"
